# ── 앱 기본 ────────────────────────────────────────────────────────────────
# 쿠키 서명 + 액세스 토큰 암호화에 쓰이는 마스터 시크릿.
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET=change-me-to-a-long-random-string
# 배포된 공개 URL. OAuth redirect_uri 를 만들 때 사용합니다. (끝에 / 없이)
# Vercel 에서 비워두면 프로덕션 도메인(https://<project>.vercel.app)을 자동으로 씁니다.
# 커스텀 도메인을 쓴다면 그 주소를 넣으세요.
PUBLIC_BASE_URL=http://localhost:3000

# ── 데이터베이스 ──────────────────────────────────────────────────────────
# 로컬: SQLite 파일 하나면 충분합니다.
DATABASE_URL=sqlite:///./local.db
# Vercel: Neon / Vercel Postgres 연결 문자열로 교체하세요.
#   예) postgresql+psycopg://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# ── 로그인 방식 A (권장): Instagram 로그인 ─────────────────────────────────
# Meta 앱 대시보드 → 사용 사례 "Instagram에서 메시지 및 콘텐츠 관리"
#   → "Instagram 로그인을 통한 API 설정" 상단의 Instagram 앱 ID / 시크릿 코드.
# 둘 다 있으면 이 방식을 씁니다. Facebook 페이지 연결이 필요 없습니다.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── 로그인 방식 B: Facebook 로그인 (INSTAGRAM_APP_* 가 비어 있을 때) ────────
# https://developers.facebook.com/apps  →  앱 만들기 →  설정 > 기본
META_APP_ID=
META_APP_SECRET=
# Graph API 버전
META_API_VERSION=v23.0

# ── Gemini: 카드뉴스(구성·사진 AI 편집) + 댓글 감정 분석 ─────────────────
# https://aistudio.google.com/apikey 에서 발급. 비워두면 카드뉴스는 기본 구성·기본 보정,
# 감정 분석은 한국어 키워드·이모지 규칙으로 동작합니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# 카드뉴스: 사진 분석·구성(텍스트) / 사진 AI 편집(이미지) 모델
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── Vercel Cron 보호 ─────────────────────────────────────────────────────
# 설정하면 Vercel 이 cron 호출에 Authorization: Bearer <CRON_SECRET> 를 자동으로 붙입니다.
CRON_SECRET=

# ── 댓글 자동 응답 (Meta Webhooks) ────────────────────────────────────────
# Meta 앱 → Webhooks 설정의 "인증 토큰" 칸에 같은 값을 넣습니다 (아무 임의 문자열).
# 콜백 URL: {PUBLIC_BASE_URL}/api/py/webhooks/instagram · 구독 필드: comments, messages
WEBHOOK_VERIFY_TOKEN=
