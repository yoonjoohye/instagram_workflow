# ── 앱 기본 ────────────────────────────────────────────────────────────────
# 쿠키 서명 + 액세스 토큰 암호화에 쓰이는 마스터 시크릿.
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET=change-me-to-a-long-random-string
# 배포된 공개 URL. OAuth redirect_uri 를 만들 때 사용합니다. (끝에 / 없이)
# Vercel 에서 비워두면 프로덕션 도메인(https://<project>.vercel.app)을 자동으로 씁니다.
# 커스텀 도메인을 쓴다면 그 주소를 넣으세요.
PUBLIC_BASE_URL=http://localhost:3000

# ── 데이터베이스 ──────────────────────────────────────────────────────────
# 로컬: SQLite 파일 하나면 충분합니다.
DATABASE_URL=sqlite:///./local.db
# Vercel: Neon / Vercel Postgres 연결 문자열로 교체하세요.
#   예) postgresql+psycopg://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# ── Meta / Instagram (Facebook Login) ────────────────────────────────────
# https://developers.facebook.com/apps  →  앱 만들기 →  설정 > 기본
META_APP_ID=
META_APP_SECRET=
# Graph API 버전
META_API_VERSION=v23.0

# ── 생성 엔진: Higgsfield ────────────────────────────────────────────────
# https://console.higgsfield.ai 에서 발급. 비워두면 자동으로 mock 으로 동작합니다.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
# 콘솔의 모델 카탈로그에서 확인한 경로로 바꿔 쓰세요.
HIGGSFIELD_IMAGE_PATH=/v1/higgsfield-ai/soul/v2/standard
HIGGSFIELD_VIDEO_PATH=/v1/higgsfield-ai/dop/v2/turbo
HIGGSFIELD_AUDIO_PATH=/v1/higgsfield-ai/audio/v1/music

# ── 캡션(게시물 글) 생성: Claude API ──────────────────────────────────────
# 비워두면 템플릿 기반 목업 캡션이 생성됩니다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Vercel Cron 보호 ─────────────────────────────────────────────────────
# 설정하면 Vercel 이 cron 호출에 Authorization: Bearer <CRON_SECRET> 를 자동으로 붙입니다.
CRON_SECRET=
