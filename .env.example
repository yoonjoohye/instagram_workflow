# ── 앱 기본 ────────────────────────────────────────────────────────────────
# 쿠키 서명 + 액세스 토큰 암호화에 쓰이는 마스터 시크릿.
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET=change-me-to-a-long-random-string
# 배포된 공개 URL. OAuth redirect_uri 를 만들 때 사용합니다. (끝에 / 없이)
# Vercel 에서 비워두면 프로덕션 도메인(https://<project>.vercel.app)을 자동으로 씁니다.
# 커스텀 도메인을 쓴다면 그 주소를 넣으세요.
PUBLIC_BASE_URL=http://localhost:3000

# ── 데이터베이스 ──────────────────────────────────────────────────────────
# 로컬: SQLite 파일 하나면 충분합니다.
DATABASE_URL=sqlite:///./local.db
# Vercel: Neon / Vercel Postgres 연결 문자열로 교체하세요.
#   예) postgresql+psycopg://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# ── 회원 로그인은 이메일 + 비밀번호. 인증번호 메일은 Resend 로 보냅니다 ─────────
# https://resend.com → API Keys. 비워 두면 로컬에서는 인증번호를 화면·서버 로그에 보여 줍니다(배포에서는 오류).
RESEND_API_KEY=
# 보내는 사람. 도메인 인증 전에는 onboarding@resend.dev (Resend 가입 메일 주소로만 발송됨)
MAIL_FROM=Auto Studio <onboarding@resend.dev>

# ── 계정 연동 A: Instagram 로그인 (회원에 Instagram 계정 여러 개 연동) ──────────
# Meta 앱 대시보드 → 사용 사례 "Instagram에서 메시지 및 콘텐츠 관리"
#   → "Instagram 로그인을 통한 API 설정" 상단의 Instagram 앱 ID / 시크릿 코드.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── 계정 연동 B: Facebook 로그인 (페이지에 연결된 Instagram 계정, 릴스 음악 등 Facebook 전용 기능) ──
# https://developers.facebook.com/apps  →  설정 > 기본의 앱 ID / 앱 시크릿 코드
META_APP_ID=
META_APP_SECRET=

# ── Threads (아직 화면 없음) ───────────────────────────────────────────────
THREADS_APP_ID=
THREADS_APP_SECRET=
# Graph API 버전
META_API_VERSION=v23.0

# ── Gemini: 게시물 만들기(조사·구성·이미지 연출) + 댓글 감정 분석 ─────────────────
# https://aistudio.google.com/apikey 에서 발급. 비워두면 게시물은 올린 사진 기본 보정,
# 감정 분석은 한국어 키워드·이모지 규칙으로 동작합니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# 게시물 만들기: 조사·구성(텍스트) / 이미지 연출·생성(이미지) 모델
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ── Vercel Cron 보호 ─────────────────────────────────────────────────────
# 설정하면 Vercel 이 cron 호출에 Authorization: Bearer <CRON_SECRET> 를 자동으로 붙입니다.
CRON_SECRET=

# ── 댓글 자동 응답 (Meta Webhooks) ────────────────────────────────────────
# Meta 앱 → Webhooks 설정의 "인증 토큰" 칸에 같은 값을 넣습니다 (아무 임의 문자열).
# 콜백 URL: {PUBLIC_BASE_URL}/api/py/webhooks/instagram · 구독 필드: comments, messages
WEBHOOK_VERIFY_TOKEN=

# ── 동영상 저장소 (Vercel Blob) ───────────────────────────────────────────
# Vercel → Storage → Blob 스토어를 연결하면 자동으로 들어옵니다 (vercel env pull 로 로컬에도).
BLOB_READ_WRITE_TOKEN=

# ── 로컬 개발 전용 ──────────────────────────────────────────────────────────
# 1 이면 로그인 화면에 '로컬 테스트 로그인' 버튼 (localhost 요청에서만, Vercel 에서는 항상 꺼짐)
DEV_LOGIN=0

# ── SEO (선택) ──────────────────────────────────────────────────────────────
# 사이트 주소 (비우면 Vercel 프로덕션 도메인). 자체 도메인을 쓰면 넣으세요.
NEXT_PUBLIC_SITE_URL=
# 구글 서치 콘솔 · 네이버 서치어드바이저 'HTML 태그' 확인 값 (content="…" 부분)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
