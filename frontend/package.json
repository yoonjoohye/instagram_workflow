{
  "name": "instagram-auto-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "cd .. && ./.venv/bin/uvicorn backend.main:app --reload --port 8000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "test:api": "cd .. && ./.venv/bin/python -m pytest -q -c backend/pytest.ini backend/tests",
    "check": "tsc --noEmit && npm run check:i18n && npm run test:api"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@vercel/blob": "^2.8.0",
    "exifr": "^7.1.3",
    "fabric": "^7.4.0",
    "heic-to": "^1.6.5",
    "mediabunny": "^1.61.3",
    "next": "15.5.26",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
