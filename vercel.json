{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": { "root": "frontend", "framework": "nextjs" },
    "api": {
      "root": ".",
      "entrypoint": "api/index.py",
      "functions": {
        "api/index.py": {
          "maxDuration": 60,
          "includeFiles": "backend/**",
          "excludeFiles": "{frontend,mobile,docs,backend/tests,backend/scripts}/**"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/py(/.*)?", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [{ "path": "/api/py/cron/sync-insights", "schedule": "0 3 * * *" }]
}
